# Copy to .env and fill in. Never commit the real .env file.

# --- Binance API credentials ---
# Create keys at https://www.binance.com/en/my/settings/api-management
# For DRY_RUN=true these are unused. For USE_TESTNET=true, use testnet keys
# from https://testnet.binance.vision instead of your real account keys.
BINANCE_API_KEY=your-api-key
BINANCE_API_SECRET=your-api-secret

# --- Safety switches ---
# DRY_RUN=true:  no network orders at all, fills are simulated locally against
#                live market data. Use this first.
# USE_TESTNET=true: hits Binance's real testnet servers with fake funds.
#                Use this second, once DRY_RUN results look sane.
# Only set BOTH to false once you have paper-tested and are ready to risk
# real money, starting small.
DRY_RUN=true
USE_TESTNET=true

# --- Market ---
SYMBOL=BTCUSDT
QUOTE_ASSET=USDT
INTERVAL=1h

# --- Strategy (EMA trend-following) ---
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
RSI_PERIOD=14
RSI_ENTRY_MIN=50

# --- Risk management ---
RISK_PER_TRADE_PCT=0.01
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_DAILY_LOSS_PCT=0.03
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=3
COOLDOWN_MINUTES=60

# --- Paper trading ---
# Virtual USDT balance used for position sizing while DRY_RUN=true.
PAPER_EQUITY=500

# --- Operations ---
POLL_SECONDS=60
STATE_DB_PATH=trading-bot/state.db
LOG_DIR=trading-bot/logs
KILL_SWITCH_PATH=trading-bot/STOP
# Optional Slack/Discord incoming webhook URL for buy/sell/error alerts.
WEBHOOK_URL=
