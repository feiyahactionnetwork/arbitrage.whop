# .env.example

# Supabase Configuration
SUPABASE_URL=https://your-supabase-url
SUPABASE_ANON_KEY=your-anon-key

# Cloudinary Configuration
CLOUDINARY_URL=cloudinary://your-cloud-name:your-api-key

# M-Pesa Configuration
